{
    "type": "php-ext",
    "name": "swow/swow-extension",
    "description": "Swow PHP extension",
    "keywords": [
        "swow",
        "php",
        "extension"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "twose",
            "email": "twosee@php.net"
        }
    ],
    "support": {
        "issues": "https://github.com/swow/swow"
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "swow/swow-utils": ">=0.2.0"
    },
    "bin": [
        "bin/swow-builder"
    ],
    "php-ext": {
        "extension-name": "swow",
        "configure-options": [
            {
                "name": "enable-swow-debug",
                "description": "Enable Swow debug build flags",
                "needs-value": false
            },
            {
                "name": "enable-swow-debug-log",
                "description": "Enable Swow debug log",
                "needs-value": false
            },
            {
                "name": "enable-swow-gcov",
                "description": "Enable Swow GCOV support",
                "needs-value": false
            },
            {
                "name": "enable-swow-valgrind",
                "description": "Enable Swow valgrind support",
                "needs-value": false
            },
            {
                "name": "enable-swow-memory-sanitizer",
                "description": "Enable Swow MSan support",
                "needs-value": false
            },
            {
                "name": "enable-swow-address-sanitizer",
                "description": "Enable Swow ASan support",
                "needs-value": false
            },
            {
                "name": "enable-swow-undefined-sanitizer",
                "description": "Enable Swow UBSan support",
                "needs-value": false
            },
            {
                "name": "enable-swow-ssl",
                "description": "Enable Swow OpenSSL support",
                "needs-value": false
            },
            {
                "name": "enable-swow-curl",
                "description": "Enable Swow cURL support",
                "needs-value": false
            },
            {
                "name": "enable-swow-pdo-pgsql",
                "description": "Enable Swow PDO_PGSQL support",
                "needs-value": false
            }
        ]
    }
}
